# Copy to .env. Everything here is optional; defaults are safe.
# Web UI bind address. Keep 127.0.0.1 unless you understand the risk (see docs/SECURITY.md).
MH_HOST=127.0.0.1
MH_PORT=4019
# Where the database, logs, work files and encryption key live.
MH_DATA_DIR=./data
# Optional: fixed admin password for the dashboard. If unset, one is generated on first run.
# MH_ADMIN_PASSWORD=
# Optional: 32-byte hex key for encrypting stored secrets. If unset, a key file is created in the data dir.
# MH_SECRET_KEY=
# Log level: debug | info | warn | error
MH_LOG_LEVEL=info
